{
  "name": "apex-debugger",
  "description": "browser extension",
  "version": "0.0.1",
  "author": "motiko",
  "license": "MIT",
  "main": "",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ..",
    "format": "prettier --write --ignore-path ../.prettierignore src vite.config.mjs ../e2e ../scripts ../eslint.config.js",
    "format:check": "prettier --check --ignore-path ../.prettierignore src vite.config.mjs ../e2e ../scripts ../eslint.config.js",
    "react-devtools": "react-devtools"
  },
  "dependencies": {
    "idb-keyval": "^2.3.0",
    "js-beautify": "^2.0.3",
    "material-ui": "1.0.0-beta.38",
    "material-ui-color-picker": "github:motiko/material-ui-color-picker#controlled",
    "material-ui-icons": "^1.0.0-beta.36",
    "prop-types": "^15.6.1",
    "rc-slider": "^8.6.1",
    "rc-tooltip": "^3.7.0",
    "react": "^16.2.0",
    "react-dom": "^16.1.1",
    "react-redux": "^5.0.6",
    "react-router-dom": "^4.2.2",
    "react-select": "^1.2.1",
    "redux": "^3.7.2",
    "redux-localstorage": "^1.0.0-rc5",
    "redux-localstorage-filter": "^0.1.1",
    "redux-thunk": "2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "extend": ">=2.0.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
