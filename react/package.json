{
  "name": "apex-debugger",
  "description": "browser extension",
  "version": "0.0.1",
  "author": "motiko",
  "license": "MIT",
  "main": "",
  "private": true,
  "scripts": {
    "build": "browserify -g [ envify --NODE_ENV production ] -t [ babelify  ] -t [ browserify-css --global ] -g [ uglifyify ] src/*.js | uglifyjs --compress --mangle | tee ../chrome/app/js/build/app.js > /dev/null",
    "watch": "watchify -t [ babelify ]  -t [ browserify-css --global  ] src/*.js -o '| tee ../chrome/app/js/build/app.js > /dev/null'",
    "clean": "rm ../chrome/app/js/build/app.js",
    "react-devtools": "react-devtools",
    "test": "standard"
  },
  "dependencies": {
    "@babel/plugin-proposal-decorators": "^7.22.0",
    "@babel/runtime": "^7.26.0",
    "@babel/runtime-corejs2": "^7.26.10",
    "@material-ui/icons": "^1.1.1",
    "browserify": "^16.3.0",
    "core-js": "^2.6.12",
    "idb-keyval": "^2.3.0",
    "material-ui": "1.0.0-beta.38",
    "material-ui-color-picker": "github:motiko/material-ui-color-picker#controlled",
    "prop-types": "^15.6.1",
    "rc-slider": "^8.6.1",
    "rc-tooltip": "^3.7.0",
    "react": "^16.2.0",
    "react-dom": "^16.1.1",
    "react-redux": "^5.0.6",
    "react-router-dom": "^4.2.2",
    "react-select": "^1.2.1",
    "redux": "^3.7.2",
    "redux-localstorage": "^1.0.0-rc5",
    "redux-localstorage-filter": "^0.1.1",
    "redux-thunk": "2.2.0",
    "regenerator-runtime": "^0.11.0",
    "watchify": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-runtime": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "babelify": "^10.0.0",
    "browserify-css": "^0.15.0",
    "envify": "^4.1.0",
    "extend": ">=2.0.2",
    "prettier": "^1.11.1",
    "reactify": "^1.1.1",
    "uglify-js": "^3.3.16",
    "uglifyify": "^4.0.5"
  }
}
