{
  "name": "apex-debugger",
  "description": "browser extension",
  "version": "0.0.1",
  "author": "motiko",
  "license": "MIT",
  "main": "",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ..",
    "format": "prettier --write --ignore-path ../.prettierignore src vite.config.mjs build.mjs ../e2e ../scripts ../eslint.config.js",
    "format:check": "prettier --check --ignore-path ../.prettierignore src vite.config.mjs build.mjs ../e2e ../scripts ../eslint.config.js",
    "react-devtools": "react-devtools"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-virtual": "^3.14.14",
    "js-beautify": "^2.0.3",
    "mousetrap": "^1.6.5",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/mousetrap": "^1.6.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "extend": ">=2.0.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
