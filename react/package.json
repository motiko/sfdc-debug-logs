{
  "name": "apex-debugger",
  "description": "browser extension",
  "version": "0.0.1",
  "author": "motiko",
  "license": "MIT",
  "main": "",
  "private": true,
  "scripts": {
    "build": "browserify -g [ envify --NODE_ENV production ] -t [ babelify  ] -t [ browserify-css --global ] -g [ uglifyify ] src/*.js | uglifyjs --compress --mangle | tee ../chrome/app/js/build/app.js > /dev/null",
    "watch": "watchify -t [ babelify ]  -t [ browserify-css --global  ] src/*.js -o '| tee ../chrome/app/js/build/app.js > /dev/null'",
    "clean": "rm ../chrome/app/js/build/app.js",
    "react-devtools": "react-devtools",
    "test": "standard"
  },
  "dependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/runtime": "^8.0.7",
    "@babel/runtime-corejs2": "^7.29.7",
    "browserify": "^17.0.1",
    "core-js": "^3.50.0",
    "idb-keyval": "^6.3.0",
    "material-ui": "1.0.0-beta.46",
    "material-ui-color-picker": "github:motiko/material-ui-color-picker#controlled",
    "material-ui-icons": "^1.0.0-beta.36",
    "prop-types": "^15.6.1",
    "rc-slider": "^11.1.9",
    "rc-tooltip": "^6.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "react-select": "^5.10.2",
    "redux": "^5.0.1",
    "redux-localstorage": "^1.0.0-rc5",
    "redux-localstorage-filter": "^0.1.1",
    "redux-thunk": "3.1.0",
    "regenerator-runtime": "^0.14.1",
    "watchify": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "babelify": "^10.0.0",
    "browserify-css": "^0.15.0",
    "envify": "^4.1.0",
    "extend": ">=2.0.2",
    "prettier": "^3.9.9",
    "reactify": "^1.1.1",
    "uglify-js": "^3.3.16",
    "uglifyify": "^5.0.2"
  }
}
