# Salesforce login for scripts/chrome-dev.sh, scripts/sf-login.mjs and the e2e
# flow against a real org (see scripts/lib/sf-auth.mjs). Copy to .env.local.

SF_USER=
# OAuth 2.0 JWT bearer flow (setup: docs/e2e-jwt-setup.md): the External
# Client App's consumer key and the private key of its certificate. *.pem is
# gitignored. Instead of a file, SF_JWT_KEY can hold the PEM (newlines as \n)
# or the PEM base64-encoded.
SF_CLIENT_ID=
SF_JWT_KEY_FILE=sf-jwt-key.pem
# Optional: https://test.salesforce.com for sandboxes, or the org's My Domain
# URL. The JWT audience follows it (SF_JWT_AUDIENCE overrides).
SF_LOGIN_URL=

# Deprecated: SOAP login(), used only while SF_CLIENT_ID and the key aren't
# set. Salesforce retires SOAP login in Summer '27.
# SF_PASS=
# SF_TOKEN=

# Optional second org, used when the first one is near its daily API limit
# (SF_MIN_API_REQUESTS, default 500). Add _3, _4, ... for more.
SF_USER_2=
SF_CLIENT_ID_2=
SF_JWT_KEY_FILE_2=
SF_LOGIN_URL_2=
