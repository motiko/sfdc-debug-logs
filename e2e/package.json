{
  "name": "apex-debugger-e2e",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm --prefix ../react run build --silent && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 --test-timeout=300000 apex-logs.test.mjs",
    "ux-audit": "npm --prefix ../react run build --silent && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ux-audit.mjs",
    "test:mock": "npm --prefix ../react run build --silent && SF_MOCK=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 --test-timeout=300000 apex-logs.test.mjs",
    "ux-audit:mock": "npm --prefix ../react run build --silent && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ux-audit.mjs --mock",
    "test:harness": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 mock/*.test.mjs"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.4",
    "axe-core": "^4.14.0",
    "puppeteer-core": "^25.13.0"
  }
}
